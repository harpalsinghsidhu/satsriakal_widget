<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="14dp">
    
    <ViewFlipper
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="450">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame_0" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame_1" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame_2" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame_3" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame_4" />
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/frame_5" />
    </ViewFlipper>
</FrameLayout>
